+/* ========================================================================
+   ARDUINO-SIM.JS — شبیه‌ساز سبک آردوینو برای مأموریت اول (LED چشمک‌زن)
+   از ARDUINO-LANG.JS (تفسیرگر) استفاده می‌کند و یک ادیتور کد + مدار SVG +
+   کنسول را می‌سازد. وقتی کد کاربر واقعاً LED را چشمک‌زن کند، callback
+   onSuccess صدا زده می‌شود تا quest.js مأموریت را تکمیل کند.
+   ======================================================================== */
+
+const ArduinoSim = (() => {
+  const CODE_STORAGE_PREFIX = 'shovalie-madar-arduino-code-v1:';
+  const RUN_SPEED = 2.2;          // شبیه‌سازی چندبرابر سریع‌تر از واقعیت
+  const MIN_STEP_MS = 12;
+  const MAX_STEP_MS = 900;
+  const MAX_RUN_MS = 11000;       // سقف زمان واقعیِ هر اجرا
+
+  function starterCode(pin) {
+    return `// چراغ‌قلعه: یک LED با یک مقاومت ۲۲۰ اهم به پایه ${pin} و GND وصل است.
+// وظیفه: کد را کامل کن تا LED با delay() چشمک بزند (روشن، مکث، خاموش، مکث...)
+
+int ledPin = ${pin};
+
+void setup() {
+  // TODO: پایه LED را با pinMode روی OUTPUT تنظیم کن
+
+}
+
+void loop() {
+  // TODO: با digitalWrite و delay، LED را روشن و خاموش کن
+
+}
+`;
+  }
+
+  function loadSavedCode(id, pin) {
+    try {
+      const raw = localStorage.getItem(CODE_STORAGE_PREFIX + id);
+      if (raw) return raw;
+    } catch (e) { /* ignore */ }
+    return starterCode(pin);
+  }
+  function saveCode(id, code) {
+    try { localStorage.setItem(CODE_STORAGE_PREFIX + id, code); } catch (e) { /* ignore */ }
+  }
+
+  /* ------------------------------ SVG circuit ------------------------------ */
+  function boardSVG(pin) {
+    return `
+    <svg viewBox="0 0 300 190" class="sim-board-svg" aria-hidden="true">
+      <defs>
+        <filter id="simLedGlow" x="-120%" y="-120%" width="340%" height="340%">
+          <feGaussianBlur stdDeviation="5" result="blur"/>
+          <feMerge>
+            <feMergeNode in="blur"/>
+            <feMergeNode in="SourceGraphic"/>
+          </feMerge>
+        </filter>
+      </defs>
+
+      <rect x="170" y="46" width="112" height="112" rx="8" class="sim-bb-outline"/>
+
+      <rect x="8" y="15" width="140" height="160" rx="10" class="sim-board-body"/>
+      <rect x="55" y="4" width="30" height="13" rx="2" class="sim-usb"/>
+      <text x="78" y="34" text-anchor="middle" class="sim-board-label">ARDUINO</text>
+      <text x="78" y="48" text-anchor="middle" class="sim-board-sub">UNO</text>
+
+      <circle cx="148" cy="70" r="3.2" class="sim-pin-dot sim-pin-live"/>
+      <text x="137" y="73.5" text-anchor="end" class="sim-pin-label">${pin}</text>
+      <circle cx="148" cy="140" r="3.2" class="sim-pin-dot sim-pin-gnd"/>
+      <text x="137" y="143.5" text-anchor="end" class="sim-pin-label sim-pin-label-muted">GND</text>
+
+      <line x1="148" y1="70" x2="176" y2="70" class="sim-wire sim-wire-live"/>
+      <rect x="176" y="64" width="38" height="12" rx="2" class="sim-resistor-body"/>
+      <rect x="184" y="64" width="3" height="12" class="sim-band sim-band-1"/>
+      <rect x="192" y="64" width="3" height="12" class="sim-band sim-band-2"/>
+      <rect x="200" y="64" width="3" height="12" class="sim-band sim-band-3"/>
+      <line x1="214" y1="70" x2="245" y2="70" class="sim-wire sim-wire-live"/>
+
+      <g id="simLedGroup" class="sim-led-group">
+        <line x1="262" y1="53" x2="270" y2="45" class="sim-led-ray"/>
+        <line x1="262" y1="53" x2="254" y2="45" class="sim-led-ray"/>
+        <line x1="270" y1="70" x2="280" y2="70" class="sim-led-ray"/>
+        <circle id="simLedBulb" cx="262" cy="70" r="17" class="sim-led-bulb"/>
+      </g>
+      <line x1="262" y1="87" x2="262" y2="140" class="sim-wire sim-wire-gnd"/>
+      <line x1="262" y1="140" x2="148" y2="140" class="sim-wire sim-wire-gnd"/>
+
+      <text x="262" y="178" text-anchor="middle" class="sim-caption">LED + مقاومت ۲۲۰Ω</text>
+    </svg>`;
+  }
+
+  /* --------------------------- success detection --------------------------- */
+  function checkBlink(events, pin, pinModes) {
+    if (pinModes[pin] !== 'OUTPUT') {
+      return { ok: false, reason: `پایه ${pin} هنوز با ()pinMode روی OUTPUT تنظیم نشده.` };
+    }
+    const pinEvents = events.filter(e => e.pin === pin);
+    if (pinEvents.length < 2) {
+      return { ok: false, reason: 'هنوز LED روشن و خاموش (چشمک) نشده — از ()digitalWrite با HIGH و LOW استفاده کن.' };
+    }
+    let toggles = 0;
+    for (let i = 1; i < pinEvents.length; i++) {
+      if (pinEvents[i].val !== pinEvents[i - 1].val && pinEvents[i].ms > pinEvents[i - 1].ms) toggles++;
+    }
+    if (toggles < 2) {
+      return { ok: false, reason: 'LED باید حداقل یک‌بار کامل روشن ← خاموش ← روشن شود (با delay() بین هرکدام).' };
+    }
+    return { ok: true };
+  }
+
+  /* --------------------------------- mount --------------------------------- */
+  function mount(container, opts) {
+    const { missionId, pin, alreadyDone, onSuccess } = opts;
+
+    container.innerHTML = `
+      <div class="sim-wrap">
+        <div class="sim-board-wrap">
+          ${boardSVG(pin)}
+        </div>
+        <div class="sim-status" data-state="idle">کد را در ادامه بنویس و «اجرا کن» را بزن.</div>
+        <div class="sim-editor-head">
+          <span class="sim-editor-title">کد آردوینو (Arduino C++)</span>
+          <div class="sim-actions">
+            <button type="button" class="sim-btn sim-btn-ghost" data-act="reset">↺ کد اولیه</button>
+            <button type="button" class="sim-btn sim-btn-stop" data-act="stop" disabled>■ توقف</button>
+            <button type="button" class="sim-btn sim-btn-run" data-act="run">▶ اجرا کن</button>
+          </div>
+        </div>
+        <textarea class="sim-editor mono" spellcheck="false" autocapitalize="off" autocorrect="off"></textarea>
+        <div class="sim-console mono" data-role="console"></div>
+      </div>`;
+
+    const el = {
+      status: container.querySelector('.sim-status'),
+      editor: container.querySelector('.sim-editor'),
+      console: container.querySelector('[data-role="console"]'),
+      runBtn: container.querySelector('[data-act="run"]'),
+      stopBtn: container.querySelector('[data-act="stop"]'),
+      resetBtn: container.querySelector('[data-act="reset"]'),
+      ledBulb: container.querySelector('#simLedBulb'),
+      ledGroup: container.querySelector('#simLedGroup')
+    };
+
+    el.editor.value = loadSavedCode(missionId, pin);
+    let saveTimer = null;
+    el.editor.addEventListener('input', () => {
+      clearTimeout(saveTimer);
+      saveTimer = setTimeout(() => saveCode(missionId, el.editor.value), 300);
+    });
+
+    let successFired = !!alreadyDone;
+    let running = false;
+    let stopRequested = false;
+    let runToken = 0;
+
+    function setStatus(text, state) {
+      el.status.textContent = text;
+      el.status.setAttribute('data-state', state || 'idle');
+    }
+    function logLine(text, cls) {
+      const line = document.createElement('div');
+      if (cls) line.className = cls;
+      line.textContent = text;
+      el.console.appendChild(line);
+      el.console.scrollTop = el.console.scrollHeight;
+      while (el.console.childNodes.length > 200) el.console.removeChild(el.console.firstChild);
+    }
+    function clearConsole() { el.console.innerHTML = ''; }
+
+    function setLed(ratio) {
+      const r = Math.max(0, Math.min(1, ratio));
+      el.ledGroup.classList.toggle('is-on', r > 0.02);
+      el.ledBulb.style.setProperty('--sim-led-ratio', r.toFixed(3));
+    }
+
+    function setRunning(isRunning) {
+      running = isRunning;
+      el.runBtn.disabled = isRunning;
+      el.stopBtn.disabled = !isRunning;
+      el.resetBtn.disabled = isRunning;
+    }
+
+    if (alreadyDone) {
+      setStatus('این مأموریت قبلاً با موفقیت تکمیل شده — می‌تونی دوباره تمرین کنی. ✓', 'success');
+      setLed(1);
+    }
+
+    function makeIO() {
+      const io = {
+        pinModes: {},
+        pinStates: {},
+        _ms: 0,
+        pinMode(p, mode) {
+          io.pinModes[p] = mode;
+          if (p === pin && mode !== 'OUTPUT') {
+            logLine(`⚠️ پایه ${pin} روی «${mode}» تنظیم شد، نه OUTPUT — LED روشن نخواهد شد.`, 'sim-warn');
+          }
+        },
+        digitalWrite(p, val) {
+          const v = val ? 1 : 0;
+          io.pinStates[p] = v;
+          events.push({ pin: p, val: v, ms: io._ms });
+          if (p === pin) setLed(v);
+        },
+        digitalRead(p) { return io.pinStates[p] || 0; },
+        analogWrite(p, val) {
+          const v = Math.max(0, Math.min(255, Math.round(val)));
+          io.pinStates[p] = v;
+          events.push({ pin: p, val: v, ms: io._ms, pwm: true });
+          if (p === pin) setLed(v / 255);
+        },
+        analogRead() { return 512; },
+        millis() { return Math.round(io._ms); },
+        serialPrint(text) {
+          text.split('\n').forEach((seg, idx, arr) => {
+            if (idx < arr.length - 1 || seg) logLine(seg, 'sim-serial');
+          });
+        }
+      };
+      return io;
+    }
+
+    let events = [];
+
+    function runProgram() {
+      if (running) return;
+      const myToken = ++runToken;
+      events = [];
+      clearConsole();
+      setLed(0);
+      setStatus('در حال اجرا…', 'running');
+
+      let ast;
+      try {
+        ast = ArduinoLang.compile(el.editor.value);
+      } catch (e) {
+        setStatus('خطا در کد — کنسول را ببین.', 'error');
+        logLine('✗ ' + e.message, 'sim-error');
+        return;
+      }
+
+      const io = makeIO();
+      const interp = new ArduinoLang.Interpreter(ast, io);
+      let gen;
+      try { gen = interp.run(); }
+      catch (e) { setStatus('خطا در اجرا.', 'error'); logLine('✗ ' + e.message, 'sim-error'); return; }
+
+      setRunning(true);
+      stopRequested = false;
+      const startedAt = performance.now();
+
+      function finish(reason) {
+        if (myToken !== runToken) return;
+        setRunning(false);
+        if (reason === 'stopped') {
+          setStatus('اجرا متوقف شد.', 'idle');
+        } else if (reason === 'timeout') {
+          const check = checkBlink(events, pin, io.pinModes);
+          setStatus(check.ok ? 'خیلی خوبه — می‌تونی اجرا را ادامه بدی یا مأموریت را تمام‌شده علامت بزنی.' : ('هنوز کامل نیست: ' + check.reason), check.ok ? 'success' : 'idle');
+        }
+      }
+
+      function step() {
+        if (myToken !== runToken) return;
+        if (stopRequested) { finish('stopped'); return; }
+        let res;
+        try {
+          res = gen.next();
+        } catch (e) {
+          setRunning(false);
+          setStatus('خطا هنگام اجرا — کنسول را ببین.', 'error');
+          logLine('✗ ' + e.message, 'sim-error');
+          return;
+        }
+        if (res.done) { setRunning(false); setStatus('برنامه به پایان رسید.', 'idle'); return; }
+
+        const val = res.value;
+        const elapsedReal = performance.now() - startedAt;
+        if (elapsedReal > MAX_RUN_MS) { finish('timeout'); return; }
+
+        if (val && val.type === 'delay') {
+          io._ms += val.ms;
+          const check = checkBlink(events, pin, io.pinModes);
+          if (check.ok && !successFired) {
+            successFired = true;
+            setRunning(false);
+            setStatus('🎉 عالی بود! LED درست چشمک زد — مأموریت تکمیل شد.', 'success');
+            logLine('✓ چشمک‌زدن با موفقیت تشخیص داده شد.', 'sim-ok');
+            if (onSuccess) onSuccess();
+            return;
+          }
+          const wait = Math.max(MIN_STEP_MS, Math.min(MAX_STEP_MS, val.ms / RUN_SPEED));
+          setTimeout(step, wait);
+          return;
+        }
+        if (val && val.type === 'loopEnd') {
+          setTimeout(step, 0);
+          return;
+        }
+        setTimeout(step, 0);
+      }
+      step();
+    }
+
+    function stopProgram() {
+      stopRequested = true;
+      runToken++; // invalidate any in-flight step()
+      setRunning(false);
+      setStatus('اجرا متوقف شد.', 'idle');
+    }
+
+    function resetCode() {
+      if (running) stopProgram();
+      el.editor.value = starterCode(pin);
+      saveCode(missionId, el.editor.value);
+      setLed(0);
+      clearConsole();
+      setStatus('کد به حالت اولیه بازگشت.', 'idle');
+    }
+
+    el.runBtn.addEventListener('click', runProgram);
+    el.stopBtn.addEventListener('click', stopProgram);
+    el.resetBtn.addEventListener('click', resetCode);
+
+    return {
+      stop: stopProgram,
+      destroy() { stopProgram(); }
+    };
+  }
+
+  return { mount, checkBlink, starterCode };
+})();
