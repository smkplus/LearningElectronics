+    const atId = v => at('id', v);
+    const advance = () => tokens[pos++];
+    const err = msg => new SyntaxErr(`خطای نحوی نزدیک خط ${peek().line}: ${msg}`);
+    const expectOp = v => { if (!atOp(v)) throw err(`انتظار «${v}» می‌رفت`); return advance(); };
