+        continue;
+      }
+
+      if (c === "'") {
+        i++;
+        let s = '';
+        while (i < n && src[i] !== "'") {
+          if (src[i] === '\\') {
+            const nc = src[i + 1];
+            const map = { n: '\n', t: '\t', "'": "'", '\\': '\\', '0': '\0' };
+            s += (map[nc] !== undefined ? map[nc] : nc); i += 2; continue;
+          }
