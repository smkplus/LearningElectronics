+    let i = 0;
+    const n = src.length;
+    let line = 1;
+    const isDigit = c => c >= '0' && c <= '9';
+    const isIdentStart = c => /[A-Za-z_]/.test(c);
+    const isIdentPart = c => /[A-Za-z0-9_]/.test(c);
