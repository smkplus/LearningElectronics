+    function isTypeStart() {
+      const t = peek();
+      if (t.type !== 'id') return false;
+      if (t.value === 'const') return true;
+      if (TYPE_KEYWORDS.has(t.value)) return true;
+      const n = peek(1);
+      // Heuristic: "Ident Ident" => custom-type declaration (e.g. "Servo myServo;")
+      return !!(n && n.type === 'id');
+    }
+
